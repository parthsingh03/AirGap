<?xml version="1.0" encoding="utf-8"?>
<!-- Tactical input field: black fill, 1dp white border, square corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/background" />
    <stroke
        android:width="1dp"
        android:color="@color/on_background" />
    <corners android:radius="0dp" />
    <padding
        android:left="10dp"
        android:top="8dp"
        android:right="10dp"
        android:bottom="8dp" />
</shape>
